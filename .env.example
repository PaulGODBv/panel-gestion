# Plantilla de los secretos del panel. Copiala a `.env` y rellena los valores:
#
#   cp .env.example .env
#
# `.env` esta ignorado por git; esta plantilla si se versiona, para que se sepa
# que variables hacen falta sin publicar ninguna.

# Firma las sesiones y los enlaces de recuperacion de contrasena. Generala con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# Clave compartida con la app Android (cabecera X-API-Key). El mismo valor va en
# `local.properties` del proyecto de Android. Generala con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RETA2_API_KEY=

# Solo en produccion (con DJANGO_DEBUG=False las dos son obligatorias):
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=panel.midominio.com,api.midominio.com

# Base de datos. Sin esta variable, la base es el SQLite de siempre y no hace
# falta instalar ni configurar nada: clonar y correr `migrate` funciona.
#
# Con ella, Postgres. Es lo que se usa en produccion, porque SQLite bloquea el
# fichero entero en cada escritura y varios estudiantes sincronizando a la vez
# se ponen en cola.
#
# DATABASE_URL=postgres://usuario:clave@servidor:5432/basededatos
# DATABASE_URL=postgres://usuario:clave@servidor:5432/base?sslmode=require

# Solo en produccion:
#
# Redireccion a HTTPS. Activada por defecto con DEBUG=False. Ponla en False
# solo si el servicio ya redirige el solo y se produce un bucle.
# DJANGO_SSL_REDIRECT=True
#
# HSTS: le dice al navegador que no vuelva a entrar por HTTP en N segundos.
# Empieza en 0 a proposito. Subelo a 31536000 (un ano) SOLO cuando el dominio
# sirva bien por HTTPS: no hay forma de deshacerlo desde el servidor, el
# navegador lo recuerda.
# DJANGO_HSTS_SECONDS=0
#
# Direccion de insercion del video de la pagina publica, si va en YouTube.
# RETA2_VIDEO_PRESENTACION=
